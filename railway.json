{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "discord-bot/**",
      "local-server.js",
      "package.json",
      "package-lock.json",
      "railway.json",
      "Dockerfile"
    ]
  },
  "deploy": {
    "startCommand": "node discord-bot/index.js",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 100
  }
}
