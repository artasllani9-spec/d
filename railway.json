{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm install --prefix discord-bot --omit=dev",
    "watchPatterns": [
      "discord-bot/**",
      "public/**",
      "data/**",
      "local-server.js",
      "package.json",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node local-server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
