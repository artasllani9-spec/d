# Paste secrets here. Never commit this file or share it in chat.

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional but recommended: your Discord server ID (right-click server → Copy Server ID)
# Makes /value show up instantly instead of waiting for global commands.
DISCORD_GUILD_ID=
# Your live site URL (used for thumbnails + syncing value edits)
SITE_URL=https://d-seven-chi.vercel.app
# Optional: role that can use /editpetvalue and /edititemvalue.
# If unset, only server Administrators can edit.
DISCORD_EDITOR_ROLE_ID=
# Channel where pet/item value change embeds are posted
DISCORD_VALUE_UPDATE_CHANNEL_ID=1547718282428027011
# Must match VALUES_EDIT_TOKEN on the website (Vercel env) so bot edits sync to the live site
VALUES_EDIT_TOKEN=
