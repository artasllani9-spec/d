{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm install --prefix discord-bot",
    "watchPatterns": [
      "discord-bot/**",
      "public/**",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm start --prefix discord-bot",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
