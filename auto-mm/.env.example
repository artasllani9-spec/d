# Dedicated Auto MM Discord application (do NOT reuse the ValueDex bot token).
# On Railway, set these same names on the bot service.
AUTO_MM_DISCORD_BOT_TOKEN=
AUTO_MM_DISCORD_CLIENT_ID=
AUTO_MM_WALLET_MNEMONIC=

# Local-only aliases (also accepted):
# DISCORD_BOT_TOKEN=
# DISCORD_CLIENT_ID=
# WALLET_MNEMONIC=

# Optional. Admins can already see tickets. This role is added to each ticket too.
AUTO_MM_STAFF_ROLE_ID=
# Optional. The bot creates per-asset categories if this is empty.
AUTO_MM_ESCROW_CATEGORY_ID=
# Optional. Channel for completed-deal announcements.
AUTO_MM_DEALS_CHANNEL_ID=

ETH_RPC=https://ethereum.publicnode.com
BSC_RPC=https://bsc-dataseed.binance.org
SOL_RPC=https://api.mainnet-beta.solana.com
BTC_API=https://blockstream.info/api
LTC_API=https://litecoinspace.org/api
