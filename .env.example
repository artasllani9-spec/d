# Roblox OAuth (Creator Dashboard → Credentials → OAuth 2.0 apps)
ROBLOX_CLIENT_ID=1467861509529011675
ROBLOX_CLIENT_SECRET=

# Must exactly match a Redirect URL registered on the Roblox app:
#   https://YOUR-DOMAIN/api/auth/roblox/callback
#   http://localhost:3000/api/auth/roblox/callback
# Leave unset to auto-build from the current request host.
# ROBLOX_REDIRECT_URI=https://demand.gg/api/auth/roblox/callback
# SITE_URL=https://demand.gg

# Optional; falls back to ROBLOX_CLIENT_SECRET
SESSION_SECRET=
