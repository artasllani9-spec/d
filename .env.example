# Discord OAuth (same application as the bot)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your Discord user ID. This account is the site owner.
SITE_OWNER_ID=

# Production site (used to build the redirect URI)
SITE_URL=https://d-seven-chi.vercel.app

# Exact Redirects to add under Discord Developer Portal → OAuth2:
#   https://d-seven-chi.vercel.app/api/auth/discord/callback
#   http://localhost:3000/api/auth/discord/callback
#
# Portal: https://discord.com/developers/applications

SESSION_SECRET=

# Shared trade storage (REQUIRED on Vercel — without this, trades/bans/mods reset between requests)
# Easiest option: GitHub personal access token with Contents: Read and write
# for repo artasllani9-spec/d, then set in Vercel Project → Settings → Environment Variables:
GITHUB_TOKEN=
GITHUB_REPO=artasllani9-spec/d
GITHUB_BRANCH=main

# Optional alternatives (use any one durable backend):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# BLOB_READ_WRITE_TOKEN=
